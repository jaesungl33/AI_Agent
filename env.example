# Supabase Configuration
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_DB_URL=your_supabase_database_url

# OpenAI Configuration (for generation and reranking)
OPENAI_API_KEY=your_openai_api_key

# Optional: Qwen Configuration (alternative to OpenAI)
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=your_dashscope_api_key
QWEN_CHAT_MODEL=qwen2.5-72b-instruct
QWEN_EMBED_MODEL=text-embedding-v3

# Application Configuration
DEBUG=false
PORT=8000

# Optional: Custom embedding model dimensions (default: 384 for all-MiniLM-L6-v2)
EMBEDDING_DIMENSIONS=384